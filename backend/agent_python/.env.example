# LiveKit Rizik Agent - Copy to .env and fill in secrets
LIVEKIT_URL=wss://rizik-zwpijcjw.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Provider selector: google | siliconflow
VOICE_AI_PROVIDER=google

# Google Gemini native realtime
GOOGLE_API_KEY=your_google_api_key_here
# Optional alternative name supported by Google SDKs
GEMINI_API_KEY=your_gemini_api_key_here

# SiliconFlow (Qwen Omni via OpenAI-compatible realtime API)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
SILICONFLOW_VOICE=alloy

# SiliconFlow voice mode:
# - pipeline = STT + LLM + TTS (works today)
# - realtime = OpenAI-Realtime websocket style (currently 404 on SiliconFlow)
SILICONFLOW_VOICE_MODE=pipeline
SILICONFLOW_STT_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
SILICONFLOW_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex

# Optional fallback models/tools
GROQ_API_KEY=your_groq_api_key_here
